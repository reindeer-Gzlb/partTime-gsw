<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.V2.gameInfo.mapper.GameInfoMapper">
    
    <resultMap type="GameInfo" id="GameInfoResult">
        <result property="id"    column="id"    />
        <result property="createBy"    column="create_by"    />
        <result property="updateBy"    column="update_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="name"    column="name"    />
        <result property="type"    column="type"    />
        <result property="sort"    column="sort"    />
        <result property="icon"    column="icon"    />
        <result property="state"    column="state"    />
        <result property="del"    column="del"    />
        <result property="isSys"    column="is_sys"    />
        <result property="carrierType"    column="carrier_type"    />
    </resultMap>

    <sql id="selectGameInfoVo">
        select id, create_by, update_by, create_time, update_time, name, type, sort, icon, state, del, is_sys, carrier_type
        from game_info
    </sql>

    <select id="selectGameInfoList" parameterType="GameInfo" resultMap="GameInfoResult">
        <include refid="selectGameInfoVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="state != null "> and state = #{state}</if>
            <if test="del != null "> and del = #{del}</if>
            <if test="isSys != null "> and is_sys = #{isSys}</if>
            <if test="carrierType != null "> and carrier_type = #{carrierType}</if>
        </where>
        order by sort
    </select>
    
    <select id="selectGameInfoById" parameterType="Long" resultMap="GameInfoResult">
        <include refid="selectGameInfoVo"/>
        where id = #{id}
    </select>
    <select id="selectGameInfoByIds" parameterType="Long" resultMap="GameInfoResult">
        <include refid="selectGameInfoVo"/>
        <where>
            <if test="ids.size > 0 and ids != null">
                and id in
                <foreach item="id" collection="ids" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
            <if test="type != null "> and type = #{type}</if>
        </where>

    </select>
        
    <insert id="insertGameInfo" parameterType="GameInfo" useGeneratedKeys="true" keyProperty="id">
        insert into game_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createBy != null">create_by,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="name != null">name,</if>
            <if test="type != null">type,</if>
            <if test="sort != null">sort,</if>
            <if test="icon != null">icon,</if>
            <if test="state != null">state,</if>
            <if test="del != null">del,</if>
            <if test="isSys != null">is_sys,</if>
            <if test="carrierType != null">carrier_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createBy != null">#{createBy},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="name != null">#{name},</if>
            <if test="type != null">#{type},</if>
            <if test="sort != null">#{sort},</if>
            <if test="icon != null">#{icon},</if>
            <if test="state != null">#{state},</if>
            <if test="del != null">#{del},</if>
            <if test="isSys != null">#{isSys},</if>
            <if test="carrierType != null">#{carrierType},</if>
         </trim>
    </insert>

    <update id="updateGameInfo" parameterType="GameInfo">
        update game_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="name != null">name = #{name},</if>
            <if test="type != null">type = #{type},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="state != null">state = #{state},</if>
            <if test="del != null">del = #{del},</if>
            <if test="isSys != null">is_sys = #{isSys},</if>
            <if test="carrierType != null">carrier_type = #{carrierType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGameInfoById" parameterType="Long">
        delete from game_info where id = #{id}
    </delete>

    <delete id="deleteGameInfoByIds" parameterType="String">
        delete from game_info where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="apiSelectGameInfoList" parameterType="GameInfo" resultType="com.ruoyi.system.model.dto.api.ApiGameListDto">
        <include refid="selectGameInfoVo"/>
        <where>
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="type != null "> and type = #{type}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="icon != null  and icon != ''"> and icon = #{icon}</if>
            <if test="state != null "> and state = #{state}</if>
            <if test="del != null "> and del = #{del}</if>
            <if test="isSys != null "> and is_sys = #{isSys}</if>
            <if test="carrierType != null "> and carrier_type = #{carrierType}</if>
        </where>
        order by sort
    </select>

</mapper>