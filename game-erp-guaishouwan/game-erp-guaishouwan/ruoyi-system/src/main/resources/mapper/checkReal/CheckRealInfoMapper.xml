<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.checkReal.mapper.CheckRealInfoMapper">

    <resultMap type="CheckRealInfo" id="CheckRealInfoResult">
        <result property="id" column="id"/>
        <result property="createId" column="create_id"/>
        <result property="createTime" column="create_time"/>
        <result property="carrier" column="carrier"/>
        <result property="resultMessage" column="result_message"/>
        <result property="resultCode" column="result_code"/>
        <result property="state" column="state"/>
        <result property="requestId" column="request_id"/>
        <result property="status" column="status"/>
        <result property="inputMobile" column="input_mobile"/>
        <result property="inputName" column="input_name"/>
    </resultMap>

    <sql id="selectCheckRealInfoVo">
        select id, create_id, create_time, carrier, result_message, result_code, state, request_id, status, input_mobile, input_name from check_real_info
    </sql>
    <sql id="selectCheckRealInfoVoTwo">
        select c.id, c.create_id, u.nick_name createName, c.create_time, c.carrier, c.result_message, c.result_code, c.state, c.request_id, c.status, c.input_mobile, c.input_name
        from check_real_info c
        left join sys_user u on u.user_id =  c.create_id
    </sql>

    <select id="selectCheckRealInfoList" parameterType="CheckRealInfo" resultMap="CheckRealInfoResult">
        <include refid="selectCheckRealInfoVoTwo"/>
        <where>
            <if test="createId != null ">and c.create_id = #{createId}</if>
            <if test="carrier != null  and carrier != ''">and c.carrier = #{carrier}</if>
            <if test="resultMessage != null  and resultMessage != ''">and c.result_message = #{resultMessage}</if>
            <if test="resultCode != null  and resultCode != ''">and c.result_code = #{resultCode}</if>
            <if test="state != null  and state != ''">and c.state = #{state}</if>
            <if test="requestId != null ">and c.request_id = #{requestId}</if>
            <if test="status != null  and status != ''">and c.status = #{status}</if>
        </where>
        order by id desc
    </select>

    <select id="selectCheckRealInfoById" parameterType="Long" resultMap="CheckRealInfoResult">
        <include refid="selectCheckRealInfoVo"/>
        where id = #{id}
    </select>

    <insert id="insertCheckRealInfo" parameterType="CheckRealInfo" useGeneratedKeys="true" keyProperty="id">
        insert into check_real_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createId != null">create_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="carrier != null">carrier,</if>
            <if test="resultMessage != null">result_message,</if>
            <if test="resultCode != null">result_code,</if>
            <if test="state != null">state,</if>
            <if test="requestId != null">request_id,</if>
            <if test="status != null">status,</if>
            <if test="inputMobile != null">input_mobile,</if>
            <if test="inputName != null">input_name,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createId != null">#{createId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="carrier != null">#{carrier},</if>
            <if test="resultMessage != null">#{resultMessage},</if>
            <if test="resultCode != null">#{resultCode},</if>
            <if test="state != null">#{state},</if>
            <if test="requestId != null">#{requestId},</if>
            <if test="status != null">#{status},</if>
            <if test="inputMobile != null">#{inputMobile},</if>
            <if test="inputName != null">#{inputName},</if>
        </trim>
    </insert>

    <update id="updateCheckRealInfo" parameterType="CheckRealInfo">
        update check_real_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="createId != null">create_id = #{createId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="carrier != null">carrier = #{carrier},</if>
            <if test="resultMessage != null">result_message = #{resultMessage},</if>
            <if test="resultCode != null">result_code = #{resultCode},</if>
            <if test="state != null">state = #{state},</if>
            <if test="requestId != null">request_id = #{requestId},</if>
            <if test="status != null">status = #{status},</if>
            <if test="inputMobile != null">input_mobile= #{inputMobile},</if>
            <if test="inputName != null">input_name= #{inputName},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteCheckRealInfoById" parameterType="Long">
        delete from check_real_info where id = #{id}
    </delete>

    <delete id="deleteCheckRealInfoByIds" parameterType="String">
        delete from check_real_info where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>