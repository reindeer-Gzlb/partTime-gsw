            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUser != null">update_user = #{updateUser},</if>
            <if test="reamrk != null">reamrk = #{reamrk},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAccountPersonalDetailsById" parameterType="Long">
        delete from account_personal_details where account_id = #{id}
    </delete>

    <delete id="deleteAccountPersonalDetailsByIds" parameterType="String">
        delete from account_personal_details where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
