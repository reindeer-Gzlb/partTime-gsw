<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.model.mapper.UploadFileMapper">

    <resultMap type="UploadFile" id="UploadFileResult">
        <result property="id"    column="id"    />
        <result property="chunkCount"    column="chunk_count"    />
        <result property="createTime"    column="create_time"    />
        <result property="createName"    column="create_name"    />
        <result property="fileHash"    column="file_hash"    />
        <result property="fileName"    column="file_name"    />
        <result property="filePath"    column="file_path"    />
        <result property="fileSize"    column="file_size"    />
        <result property="status"    column="status"    />
        <result property="uploadId"    column="upload_id"    />
        <result property="fileType"    column="file_type"    />
    </resultMap>

    <sql id="selectUploadFileVo">
        select id, chunk_count, create_time, create_name, file_hash, file_name, file_path, file_size, status, upload_id, file_type from upload_file
    </sql>

    <select id="selectUploadFileList" parameterType="UploadFile" resultMap="UploadFileResult">
        <include refid="selectUploadFileVo"/>
        <where>
            <if test="chunkCount != null "> and chunk_count = #{chunkCount}</if>
            <if test="createName != null  and createName != ''"> and create_name like concat('%', #{createName}, '%')</if>
            <if test="fileHash != null  and fileHash != ''"> and file_hash = #{fileHash}</if>
            <if test="fileName != null  and fileName != ''"> and file_name like concat('%', #{fileName}, '%')</if>
            <if test="filePath != null  and filePath != ''"> and file_path = #{filePath}</if>
            <if test="fileSize != null "> and file_size = #{fileSize}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="uploadId != null  and uploadId != ''"> and upload_id = #{uploadId}</if>
            <if test="fileType != null  and fileType != ''"> and file_type = #{fileType}</if>
        </where>
    </select>

    <select id="selectUploadFileById" parameterType="Long" resultMap="UploadFileResult">
        <include refid="selectUploadFileVo"/>
        where id = #{id}
    </select>

    <insert id="insertUploadFile" parameterType="UploadFile" useGeneratedKeys="true" keyProperty="id">
        insert into upload_file
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="chunkCount != null">chunk_count,</if>
            <if test="createTime != null">create_time,</if>
            <if test="createName != null">create_name,</if>
            <if test="fileHash != null and fileHash != ''">file_hash,</if>
            <if test="fileName != null">file_name,</if>
            <if test="filePath != null">file_path,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="status != null">status,</if>
            <if test="uploadId != null and uploadId != ''">upload_id,</if>
            <if test="fileType != null">file_type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="chunkCount != null">#{chunkCount},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="createName != null">#{createName},</if>
            <if test="fileHash != null and fileHash != ''">#{fileHash},</if>
            <if test="fileName != null">#{fileName},</if>
            <if test="filePath != null">#{filePath},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="status != null">#{status},</if>
            <if test="uploadId != null and uploadId != ''">#{uploadId},</if>
            <if test="fileType != null">#{fileType},</if>
         </trim>
    </insert>

    <update id="updateUploadFile" parameterType="UploadFile">
        update upload_file
        <trim prefix="SET" suffixOverrides=",">
            <if test="chunkCount != null">chunk_count = #{chunkCount},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="createName != null">create_name = #{createName},</if>
            <if test="fileHash != null and fileHash != ''">file_hash = #{fileHash},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="filePath != null">file_path = #{filePath},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="status != null">status = #{status},</if>
            <if test="uploadId != null and uploadId != ''">upload_id = #{uploadId},</if>
            <if test="fileType != null">file_type = #{fileType},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteUploadFileById" parameterType="Long">
        delete from upload_file where id = #{id}
    </delete>


    <select id="findUploadFileWithHash" resultMap="UploadFileResult">
        <include refid="selectUploadFileVo"/>
        where file_hash = #{fileMD5Hash};
    </select>

    <delete id="deleteUploadFileByIds" parameterType="String">
        delete from upload_file where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <update id="updateByHash" parameterType="String">
        update upload_file
        <set>
            <if test="status!=null">
                `status`=#{status},
            </if>
            <if test="filePath!=null and filePath!=''">
                file_path = #{filePath},
            </if>
        </set>
        where file_hash = #{fileHash}
    </update>
</mapper>
