<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.model.mapper.SkinImgMapper">

    <resultMap type="SkinImg" id="SkinImgResult">
        <result property="id"    column="id"    />
        <result property="createId"    column="create_id"    />
        <result property="updateId"    column="update_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="skinId"    column="skin_id"    />
        <result property="parentId"    column="parent_id"    />
        <result property="imgUrl"    column="img_url"    />
    </resultMap>

    <sql id="selectSkinImgVo">
        select id, create_id, update_id, create_time, update_time, skin_id, parent_id, img_url from skin_img
    </sql>

    <select id="selectSkinImgList" parameterType="SkinImg" resultMap="SkinImgResult">
        <include refid="selectSkinImgVo"/>
        <where>
            <if test="createId != null "> and create_id = #{createId}</if>
            <if test="updateId != null "> and update_id = #{updateId}</if>
            <if test="skinId != null "> and skin_id = #{skinId}</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="imgUrl != null  and imgUrl != ''"> and img_url = #{imgUrl}</if>
        </where>
    </select>

    <select id="selectSkinImgById" parameterType="Long" resultMap="SkinImgResult">
        <include refid="selectSkinImgVo"/>
        where id = #{id}
    </select>

    <insert id="insertSkinImg" parameterType="SkinImg" useGeneratedKeys="true" keyProperty="id">
        insert into skin_img
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createId != null">create_id,</if>
            <if test="updateId != null">update_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="skinId != null">skin_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="imgUrl != null">img_url,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createId != null">#{createId},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="skinId != null">#{skinId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="imgUrl != null">#{imgUrl},</if>
         </trim>
    </insert>

    <update id="updateSkinImg" parameterType="SkinImg">
        update skin_img
        <trim prefix="SET" suffixOverrides=",">
            <if test="createId != null">create_id = #{createId},</if>
            <if test="updateId != null">update_id = #{updateId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="skinId != null">skin_id = #{skinId},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="imgUrl != null">img_url = #{imgUrl},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSkinImgById" parameterType="Long">
        delete from skin_img where id = #{id}
    </delete>

    <delete id="deleteSkinImgByIds" parameterType="String">
        delete from skin_img where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
