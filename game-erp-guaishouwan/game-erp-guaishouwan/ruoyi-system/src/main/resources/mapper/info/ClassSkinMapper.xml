<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.model.mapper.ClassSkinMapper">
    
    <resultMap type="ClassSkin" id="ClassSkinResult">
        <result property="id"    column="id"    />
        <result property="createId"    column="create_id"    />
        <result property="updateId"    column="update_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="skinId"    column="skin_id"    />
        <result property="parentId"    column="parent_id"    />
        <result property="brandname"    column="brandname"    />
        <result property="pbrandname"    column="pbrandname"    />
        <result property="skinPrice"    column="skin_price"    />
        <result property="classPrice"    column="class_price"    />
    </resultMap>

    <sql id="selectClassSkinVo">
        select id, create_id, update_id, create_time, update_time, skin_id, parent_id, brandname, pbrandname, skin_price, class_price from class_skin
    </sql>

    <select id="selectClassSkinList" parameterType="ClassSkin" resultMap="ClassSkinResult">
        <include refid="selectClassSkinVo"/>
        <where>  
            <if test="createId != null "> and create_id = #{createId}</if>
            <if test="updateId != null "> and update_id = #{updateId}</if>
            <if test="skinId != null "> and skin_id = #{skinId}</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="brandname != null  and brandname != ''"> and brandname like concat('%', #{brandname}, '%')</if>
            <if test="pbrandname != null  and pbrandname != ''"> and pbrandname like concat('%', #{pbrandname}, '%')</if>
            <if test="skinPrice != null "> and skin_price = #{skinPrice}</if>
            <if test="classPrice != null "> and class_price = #{classPrice}</if>
        </where>
    </select>
    
    <select id="selectClassSkinById" parameterType="Long" resultMap="ClassSkinResult">
        <include refid="selectClassSkinVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertClassSkin" parameterType="ClassSkin" useGeneratedKeys="true" keyProperty="id">
        insert into class_skin
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createId != null">create_id,</if>
            <if test="updateId != null">update_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="skinId != null">skin_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="brandname != null">brandname,</if>
            <if test="pbrandname != null">pbrandname,</if>
            <if test="skinPrice != null">skin_price,</if>
            <if test="classPrice != null">class_price,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createId != null">#{createId},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="skinId != null">#{skinId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="brandname != null">#{brandname},</if>
            <if test="pbrandname != null">#{pbrandname},</if>
            <if test="skinPrice != null">#{skinPrice},</if>
            <if test="classPrice != null">#{classPrice},</if>
         </trim>
    </insert>

    <update id="updateClassSkin" parameterType="ClassSkin">
        update class_skin
        <trim prefix="SET" suffixOverrides=",">
            <if test="createId != null">create_id = #{createId},</if>
            <if test="updateId != null">update_id = #{updateId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="skinId != null">skin_id = #{skinId},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="brandname != null">brandname = #{brandname},</if>
            <if test="pbrandname != null">pbrandname = #{pbrandname},</if>
            <if test="skinPrice != null">skin_price = #{skinPrice},</if>
            <if test="classPrice != null">class_price = #{classPrice},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteClassSkinById" parameterType="Long">
        delete from class_skin where id = #{id}
    </delete>

    <delete id="deleteClassSkinByIds" parameterType="String">
        delete from class_skin where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>