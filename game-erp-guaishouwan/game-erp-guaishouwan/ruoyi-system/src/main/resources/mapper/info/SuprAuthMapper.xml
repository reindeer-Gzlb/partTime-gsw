<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.model.mapper.SuprAuthMapper">

    <resultMap type="SuprAuth" id="SuprAuthResult">
        <result property="id"    column="id"    />
        <result property="createId"    column="create_id"    />
        <result property="updateId"    column="update_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="suprId"    column="supr_id"    />
        <result property="saleId"    column="sale_id"    />
        <result property="configId"    column="config_id"    />
        <result property="addsi"    column="addsi"    />
    </resultMap>

    <sql id="selectSuprAuthVo">
        select id, create_id, update_id, create_time, update_time, supr_id, sale_id,config_id,addsi from supr_auth
    </sql>

    <select id="selectSuprAuthList" parameterType="SuprAuth" resultMap="SuprAuthResult">
        <include refid="selectSuprAuthVo"/>
        <where>
            <if test="createId != null "> and create_id = #{createId}</if>
            <if test="updateId != null "> and update_id = #{updateId}</if>
            <if test="addsi != null "> and addsi = #{addsi}</if>
            <if test="suprId != null "> and supr_id = #{suprId}</if>
            <if test="saleId != null  and saleId != ''"> and sale_id = #{saleId}</if>
            <if test="configId != null  and configId != ''"> and config_id = #{configId}</if>
        </where>
        order by id desc
    </select>

    <select id="selectSuprAuthById" parameterType="Long" resultMap="SuprAuthResult">
        <include refid="selectSuprAuthVo"/>
        where id = #{id}
    </select>
    <select id="selectSaleIdAndSuper" parameterType="map" resultType="com.ruoyi.system.model.domain.SalePartner">
        <include refid="selectSuprAuthVo"/>
        <where>
            <if test="userId != null "> and supr_id = #{userId}</if>
            <if test="saleId != null  and saleId != ''"> and sale_id like '${saleId}%'</if>
        </where>
    </select>

    <insert id="insertSuprAuth" parameterType="SuprAuth" useGeneratedKeys="true" keyProperty="id">
        insert into supr_auth
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createId != null">create_id,</if>
            <if test="updateId != null">update_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="suprId != null">supr_id,</if>
            <if test="saleId != null">sale_id,</if>
            <if test="configId != null">config_id,</if>
            <if test="addsi != null">addsi,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createId != null">#{createId},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="suprId != null">#{suprId},</if>
            <if test="saleId != null">#{saleId},</if>
            <if test="configId != null">#{configId},</if>
            <if test="addsi != null">#{addsi},</if>
         </trim>
    </insert>

    <update id="updateSuprAuth" parameterType="SuprAuth">
        update supr_auth
        <trim prefix="SET" suffixOverrides=",">
            <if test="createId != null">create_id = #{createId},</if>
            <if test="updateId != null">update_id = #{updateId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="suprId != null">supr_id = #{suprId},</if>
            <if test="saleId != null">sale_id = #{saleId},</if>
            <if test="configId != null">config_id = #{configId},</if>
            <if test="addsi != null">config_id = #{addsi},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSuprAuthById" parameterType="Long">
        delete from supr_auth where id = #{id}
    </delete>

    <delete id="deleteSuprAuthByIds" parameterType="String">
        delete from supr_auth where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
