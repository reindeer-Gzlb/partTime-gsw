<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.V2.order.mapper.AccountRemakeMapper">
    
    <resultMap type="AccountRemake" id="AccountRemakeResult">
        <result property="id"    column="id"    />
        <result property="type"    column="type"    />
        <result property="tel"    column="tel"    />
        <result property="account"    column="account"    />
        <result property="pwd"    column="pwd"    />
        <result property="orderNo"    column="order_no"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="accountId"    column="account_id"    />
        <result property="superId"    column="super_id"    />
        <result property="superName"    column="super_name"    />
        <result property="saleId"    column="sale_id"    />
        <result property="saleName"    column="sale_name"    />
        <result property="ziliao"    column="ziliao"    />
    </resultMap>

    <sql id="selectAccountRemakeVo">
        select id, type, tel, account, pwd, order_no, create_by, create_time, update_by,
        update_time, remark, account_id,super_id,super_name,sale_id,sale_name,ziliao
        from account_remake
    </sql>

    <select id="selectAccountRemakeList" parameterType="AccountRemake" resultMap="AccountRemakeResult">
        <include refid="selectAccountRemakeVo"/>
        <where>  
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="tel != null  and tel != ''"> and tel = #{tel}</if>
            <if test="account != null  and account != ''"> and account = #{account}</if>
            <if test="pwd != null  and pwd != ''"> and pwd = #{pwd}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="accountId != null "> and super_id = #{superId}</if>
            <if test="saleId != null "> and sale_id = #{saleId}</if>
        </where>
    </select>
    
    <select id="selectAccountRemakeById" parameterType="Long" resultMap="AccountRemakeResult">
        <include refid="selectAccountRemakeVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertAccountRemake" parameterType="AccountRemake" useGeneratedKeys="true" keyProperty="id">
        insert into account_remake
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="type != null">type,</if>
            <if test="tel != null">tel,</if>
            <if test="account != null">account,</if>
            <if test="pwd != null">pwd,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="accountId != null">account_id,</if>
            <if test="superId != null">super_id,</if>
            <if test="superName != null">super_name,</if>
            <if test="saleId != null">sale_id,</if>
            <if test="saleName != null">sale_name,</if>
            <if test="ziliao != null">ziliao,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="type != null">#{type},</if>
            <if test="tel != null">#{tel},</if>
            <if test="account != null">#{account},</if>
            <if test="pwd != null">#{pwd},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="accountId != null">#{accountId},</if>
            <if test="superId != null">#{superId},</if>
            <if test="superName != null">#{superName},</if>
            <if test="saleId != null">#{saleId},</if>
            <if test="saleName != null">#{saleName},</if>
            <if test="ziliao != null">#{ziliao},</if>
         </trim>
    </insert>

    <update id="updateAccountRemake" parameterType="AccountRemake">
        update account_remake
        <trim prefix="SET" suffixOverrides=",">
            <if test="type != null">type = #{type},</if>
            <if test="tel != null">tel = #{tel},</if>
            <if test="account != null">account = #{account},</if>
            <if test="pwd != null">pwd = #{pwd},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="superId != null">super_id = #{superId},</if>
            <if test="superName != null">super_name = #{superName},</if>
            <if test="saleId != null">sale_id = #{saleId},</if>
            <if test="saleName != null">sale_name = #{saleName},</if>
            <if test="ziliao != null">ziliao = #{ziliao},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteAccountRemakeById" parameterType="Long">
        delete from account_remake where id = #{id}
    </delete>

    <delete id="deleteAccountRemakeByIds" parameterType="String">
        delete from account_remake where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>