    <sql id="selectBacklistVo">
        select id, create_id, update_id, create_time, update_time, type, des, region, relname, expprice,
        account,game_id,deposit_amount,pay_status,pay_record_id,pay_time,ip,ip_addr,
        tel,relname_img,status,img,supply_userId,user_phone,`partition`,transfer,other_user_id,state,gid,bc_id,back_state,cps_id,cps_name,hs_price,is_agree_bp,content,rmsg,is_black from backlist
    </sql>

    <select id="selectBacklistList" parameterType="Backlist" resultMap="BacklistResult">
        <include refid="selectBacklistVo"/>
        <where>
            state = 1
            <if test="createId != null ">and create_id = #{createId}</if>
            <if test="updateId != null ">and update_id = #{updateId}</if>
            <if test="type != null  and type != ''">and type = #{type}</if>
            <if test="des != null  and des != ''">and des like concat('%', #{des},
                '%')
            </if>
            <if test="region != null  and region != ''">and region = #{region}</if>
            <if test="relname != null  and relname != ''">and relname like concat('%', #{relname}, '%')</if>
            <if test="expprice != null  and expprice != ''">and expprice = #{expprice}</if>
            <!--            <if test="account != null  and account != ''">and account = #{account}</if>-->
            <if test="account != null  and account != ''">and account like concat('%', #{account},
                '%')
            </if>
            <if test="tel != null  and tel != ''">and tel = #{tel}</if>
            <if test="status != null ">and status = #{status}</if>
            <if test="noStatus != null ">and status != #{noStatus}</if>
            <if test="supplyUserId != null ">and supply_userId = #{supplyUserId}</if>
            <if test="userPhone != null ">and user_phone = #{userPhone}</if>
            <if test="partition != null ">and `partition` = #{partition}</if>
            <if test="transfer  != null ">and transfer = #{transfer}</if>
            <if test="otherUserId  != null ">and other_user_id = #{otherUserId}</if>
            <if test="state  != null ">and state = #{state}</if>
            <if test="gid  != null ">and gid = #{gid}</if>
            <if test="id  != null ">and id = #{id}</if>
            <if test="isAgreeBp  != null ">and is_agree_bp = #{isAgreeBp}</if>
            <if test="backState  != null ">and back_state = #{backState}</if>
            <if test="isBlack  != null and isBlack != ''">and is_black = #{isBlack}</if>
            <if test="extIds != null and extIds.size > 0">
                and id not in
                <foreach item="id" collection="extIds" open="(" separator="," close=")">
                    #{id}
                </foreach>
            </if>
        </where>
        order by id desc
    </select>
    <select id="selectBacklistById" parameterType="Long" resultMap="BacklistResult">
        <include refid="selectBacklistVo"/>
        where id = #{id}
    </select>
