    <select id="getBackCount" resultType="java.lang.Integer">
            select count(*) from backlist
            where to_days(now())-to_days(create_time) = #{day} and state=1
    </select>

    <select id="getQuaCount" resultType="java.lang.Integer">
            select count(*) from
            (select b.id from backlist b
            left join quotation q on q.back_id=b.id
            where to_days(now())-to_days(b.create_time) = #{day} and  to_days(now())-to_days(q.create_time) = #{day} and b.state=1
            GROUP BY b.id) as t
    </select>


