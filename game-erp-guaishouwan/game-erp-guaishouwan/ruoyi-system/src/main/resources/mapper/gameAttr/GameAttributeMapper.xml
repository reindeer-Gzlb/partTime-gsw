<mapper namespace="com.ruoyi.system.V2.gameAttr.mapper.GameAttributeMapper">
    
    <resultMap type="GameAttribute" id="GameAttributeResult">
        <result property="id"    column="id"    />
        <result property="gameId"    column="game_id"    />
        <result property="gameName"    column="game_name"    />
        <result property="systemKey"    column="system_key"    />
        <result property="fieldName"    column="field_name"    />
        <result property="imgUrl"    column="img_url"    />
        <result property="sort"    column="sort"    />
        <result property="parentId"    column="parent_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="acode"    column="acode"    />
        <result property="sid"    column="sid"    />
        <result property="hsisShow" column="hsis_show"/>
    </resultMap>

    <sql id="selectGameAttributeVo">
        select id, game_id, game_name, system_key, field_name, img_url, sort, parent_id, create_by, create_time,
        update_by, update_time, remark,acode,sid,hsis_show from game_attribute
    </sql>

    <select id="selectGameAttributeList" parameterType="GameAttribute" resultMap="GameAttributeResult">
        <include refid="selectGameAttributeVo"/>
        <where>  
            <if test="gameId != null "> and game_id = #{gameId}</if>
            <if test="gameName != null and gameName != ''"> and game_name like concat('%', #{gameName}, '%')</if>
            <if test="systemKey != null  and systemKey != ''"> and system_key = #{systemKey}</if>
            <if test="fieldName != null  and fieldName != ''"> and field_name like concat('%', #{fieldName}, '%')</if>
            <if test="imgUrl != null  and imgUrl != ''"> and img_url = #{imgUrl}</if>
            <if test="sort != null "> and sort = #{sort}</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="sid != null and sid != ''"> and sid = #{sid}</if>
            <if test="acode != null "> and acode like concat(#{acode}, '%')</if>
        </where>
        order by sort
    </select>

    <select id="selectGameAttributeListByParams" parameterType="GameAttribute" resultMap="GameAttributeResult">
        <include refid="selectGameAttributeVo"/>
        <where>
            <if test="gameId != null "> and game_id = #{gameId}</if>
            <if test="gameName != null and gameName != ''"> and game_name like concat('%', #{gameName}, '%')</if>
            <if test="systemKey != null  and systemKey != ''"> and system_key = #{systemKey}</if>
            <if test="fieldName != null  and fieldName != ''"> and field_name like concat('%', #{fieldName}, '%')</if>
            <if test="imgUrl != null  and imgUrl != ''"> and img_url = #{imgUrl}</if>
            <if test="sort != null "> and sort = #{sort}</if>
<!--            <if test="parentId != null "> and parent_id = #{parentId}</if>-->
            <if test="sid != null and sid != ''"> and sid = #{sid}</if>
            <if test="acode != null "> and acode like concat(#{acode}, '%')</if>
        </where>
        order by sort
    </select>
    
    <select id="selectGameAttributeById" parameterType="Long" resultMap="GameAttributeResult">
        <include refid="selectGameAttributeVo"/>
        where id = #{id}
        order by sort
    </select>
    <select id="allAttr" parameterType="Long" resultMap="GameAttributeResult">
        <include refid="selectGameAttributeVo"/>
        where id in
        <foreach item="id" collection="ids" open="(" separator="," close=")">
            #{id}
        </foreach>
        order by id
    </select>

    <insert id="insertGameAttribute" parameterType="GameAttribute" useGeneratedKeys="true" keyProperty="id">
        insert into game_attribute
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="gameId != null">game_id,</if>
            <if test="gameName != null">game_name,</if>
            <if test="systemKey != null">system_key,</if>
            <if test="fieldName != null">field_name,</if>
            <if test="imgUrl != null">img_url,</if>
            <if test="sort != null">sort,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="acode != null">acode,</if>
            <if test="sid != null and sid != ''">sid,</if>
            <if test="hsisShow != null">hsis_show,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="gameId != null">#{gameId},</if>
            <if test="gameName != null">#{gameName},</if>
            <if test="systemKey != null">#{systemKey},</if>
            <if test="fieldName != null">#{fieldName},</if>
            <if test="imgUrl != null">#{imgUrl},</if>
            <if test="sort != null">#{sort},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="acode != null">#{acode},</if>
            <if test="sid != null and  sid != ''">#{sid},</if>
            <if test="hsisShow != null">#{hsisShow},</if>
         </trim>
    </insert>

    <update id="updateGameAttribute" parameterType="GameAttribute">
        update game_attribute
        <trim prefix="SET" suffixOverrides=",">
            <if test="gameId != null">game_id = #{gameId},</if>
            <if test="gameName != null">game_name = #{gameName},</if>
            <if test="systemKey != null">system_key = #{systemKey},</if>
            <if test="fieldName != null">field_name = #{fieldName},</if>
            <if test="imgUrl != null">img_url = #{imgUrl},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="acode != null">acode = #{acode},</if>
            <if test="sid != null and  sid != ''">sid = #{sid},</if>
            <if test="hsisShow != null">hsis_show = #{hsisShow},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteGameAttributeById" parameterType="Long">
        delete from game_attribute where id = #{id}
    </delete>

    <delete id="deleteGameAttributeByIds" parameterType="String">
        delete from game_attribute where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    <select id="selectGameAttributeListBySids" resultType="com.ruoyi.system.model.domain.GameAttribute">
        <include refid="selectGameAttributeVo"/>
        where sid in
        <foreach item="id" collection="skinIds" open="(" separator="," close=")">
