<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.V2.inter.mapper.SelectPushMapper">
    
    <resultMap type="SelectPush" id="SelectPushResult">
        <result property="id"    column="id"    />
        <result property="createId"    column="create_id"    />
        <result property="updateId"    column="update_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="superId"    column="super_id"    />
        <result property="games"    column="games"    />
        <result property="config"    column="config"    />
        <result property="exids"    column="exids"    />
        <result property="state"    column="state"    />
        <result property="type"    column="type"    />
    </resultMap>

    <sql id="selectSelectPushVo">
        select id, create_id, update_id, create_time, update_time, super_id, games, config, exids,state,type from select_push
    </sql>

    <select id="selectSelectPushList" parameterType="SelectPush" resultMap="SelectPushResult">
        <include refid="selectSelectPushVo"/>
        <where>  
            <if test="createId != null "> and create_id = #{createId}</if>
            <if test="updateId != null "> and update_id = #{updateId}</if>
            <if test="superId != null  and superId != ''"> and super_id LIKE '%${superId}%'</if>
            <if test="games != null  and games != ''"> and games LIKE '%${games}%'</if>
            <if test="config != null  and config != ''"> and config = #{config}</if>
            <if test="exids != null  and exids != ''"> and exids = #{exids}</if>
            <if test="state != null  and state != ''"> and state = #{state}</if>
            <if test="id != null  and id != ''"> and id = #{id}</if>
            <if test="type != null  and type != ''"> and type = #{type}</if>
            <if test="superIdLike != null  and superIdLike != ''"> and super_id LIKE '%,${superIdLike},%'</if>
            <if test="configs != null and configs.size > 0">
                and config in
                <foreach item="config" collection="configs" open="(" separator="," close=")">
                    #{config}
                </foreach>
            </if>
        </where>
    </select>
    
    <select id="selectSelectPushById" parameterType="Long" resultMap="SelectPushResult">
        <include refid="selectSelectPushVo"/>
        where id = #{id}
    </select>

    <select id="selectSelectPushByConfig" parameterType="String" resultMap="SelectPushResult">
        <include refid="selectSelectPushVo"/>
        where config = #{config}
        <if test="state != null and state != ''">
            and state = #{state}
        </if>
    </select>


    <insert id="insertSelectPush" parameterType="SelectPush" useGeneratedKeys="true" keyProperty="id">
        insert into select_push
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="createId != null">create_id,</if>
            <if test="updateId != null">update_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="superId != null">super_id,</if>
            <if test="games != null">games,</if>
            <if test="config != null">config,</if>
            <if test="exids != null">exids,</if>
            <if test="state != null">state,</if>
            <if test="type != null">type,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="createId != null">#{createId},</if>
            <if test="updateId != null">#{updateId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="superId != null">#{superId},</if>
            <if test="games != null">#{games},</if>
            <if test="config != null">#{config},</if>
            <if test="exids != null">#{exids},</if>
            <if test="state != null">#{state},</if>
            <if test="type != null">#{type},</if>
         </trim>
    </insert>

    <update id="updateSelectPush" parameterType="SelectPush">
        update select_push
        <trim prefix="SET" suffixOverrides=",">
            <if test="createId != null">create_id = #{createId},</if>
            <if test="updateId != null">update_id = #{updateId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="superId != null">super_id = #{superId},</if>
            <if test="games != null">games = #{games},</if>
            <if test="config != null">config = #{config},</if>
            <if test="exids != null">exids = #{exids},</if>
            <if test="state != null">state = #{state},</if>
            <if test="type != null">type = #{type},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSelectPushById" parameterType="Long">
        delete from select_push where id = #{id}
    </delete>

    <delete id="deleteSelectPushByIds" parameterType="String">
        delete from select_push where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>